/* SPDX-License-Identifier: Apache-2.0 */

/ {
	aliases {
		probe0 = &probe0;
	};

	leds {
		/*
		 * Independent GPIO output, unrelated to led0, wired to pin
		 * P7.00 so it can be probed on an oscilloscope without
		 * disturbing the LED.
		 */
		probe0: probe_0 {
			gpios = <&gpio7 0 GPIO_ACTIVE_HIGH>;
			label = "Scope probe output (P7.00)";
		};
	};
};

&gpio7 {
	status = "okay";
};
